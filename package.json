{
  "name": "obsidian-rough-pomodoro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild main.ts --bundle --external:obsidian --format=cjs --platform=node --outfile=main.js",
    "build:web": "node web/build.mjs",
    "dev:web": "npm run build:web && wrangler dev",
    "deploy:web": "npm run build:web && wrangler deploy",
    "test:ui": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.8.7",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "wrangler": "^4.165.0"
  }
}
