{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "allowJs": false,
    "noEmit": true
  },
  "include": ["main.ts", "web/main.ts", "playwright.config.ts", "tests/**/*.ts"]
}
